#include <GxEPD2_3C.h>
#include <Fonts/FreeMonoBold18pt7b.h>
#include <SPI.h>

#define A GxEPD2_420c
#define B GxEPD2_3C<A,A::HEIGHT>

B d(A(0x0F,0x1B,0x1A,0x19));

static const char a[]={0x45,0x2D,0x49,0x4E,0x4B,0x20,0x34,0x2E,0x32,0x49,0x4E,0x43,0x48,0};
static const char b[]={0x50,0x68,0x75,0x63,0x20,0x2D,0x20,0x42,0x69,0x63,0x68,0};
static const char c[]={0x33,0x30,0x30,0x78,0x34,0x30,0x30,0x70,0x78,0x20,0x45,0x2D,0x50,0x61,0x70,0x65,0x72,0x20,0x44,0x69,0x73,0x70,0x6C,0x61,0x79,0x20,0x44,0x65,0x6D,0x6F,0};

static void q(const char* s,int y,uint16_t z){
  int16_t x1,y1;
  uint16_t w,h;
  d.setTextColor(z);
  d.setFont(&FreeMonoBold18pt7b);
  d.getTextBounds(String(s),0,0,&x1,&y1,&w,&h);
  d.setCursor((300-w)/2,y);
  d.println(s);
}

void setup(){
  Serial.begin(115200);
  Serial.println(c);
  SPI.begin(0x0D,-1,0x0E,0x0F);
  d.init();
  d.clearScreen();
  d.setFullWindow();
  d.firstPage();
  do{
    d.fillScreen(GxEPD_WHITE);
    q(a,120,GxEPD_BLACK);
    q(b,220,GxEPD_RED);
  }while(d.nextPage());
  d.hibernate();
}

void loop(){}
